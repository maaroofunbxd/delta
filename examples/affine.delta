# A slightly less obvious limit: (2n + 1)/n tends to 2.
# The work is in noticing that |a(n) - 2| is just 1/n.

sequence a(n) = (2 * n + 1) / n
claim a(n) -> 2

proof:
    for every eps, where eps > 0
        there is N = ceil(1 / eps)
            for every n, where n > N
                abs(a(n) - 2) < eps
end
