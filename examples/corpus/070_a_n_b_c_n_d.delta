# (a n + b) / (c n + d)
# |... - a/c| = |cb - ad| / |c(cn+d)|, bounded by |cb-ad|/(c^2 n)

sequence a(n) = (-1 * n + (3)) / (4 * n + (1))
claim a(n) -> -1 / 4

proof:
    for every eps, where eps > 0
        there is N = ceil(13 / (16 * eps))
            for every n, where n > N
                abs(a(n) - -1 / 4) < eps
end
