# (a n + b) / (c n + d)
# |... - a/c| = |cb - ad| / |c(cn+d)|, bounded by |cb-ad|/(c^2 n)

sequence a(n) = (3 * n + (1)) / (1 * n + (2))
claim a(n) -> 3 / 1

proof:
    for every eps, where eps > 0
        there is N = ceil(5 / (1 * eps))
            for every n, where n > N
                abs(a(n) - 3 / 1) < eps
end
