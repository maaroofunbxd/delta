# (a n + b) / (c n + d)
# |... - a/c| = |cb - ad| / |c(cn+d)|, bounded by |cb-ad|/(c^2 n)

sequence a(n) = (9 * n + (2)) / (3 * n + (4))
claim a(n) -> 9 / 3

proof:
    for every eps, where eps > 0
        there is N = ceil(30 / (9 * eps))
            for every n, where n > N
                abs(a(n) - 9 / 3) < eps
end
