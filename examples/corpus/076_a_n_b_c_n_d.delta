# (a n + b) / (c n + d)
# |... - a/c| = |cb - ad| / |c(cn+d)|, bounded by |cb-ad|/(c^2 n)

sequence a(n) = (8 * n + (1)) / (4 * n + (3))
claim a(n) -> 8 / 4

proof:
    for every eps, where eps > 0
        there is N = ceil(20 / (16 * eps))
            for every n, where n > N
                abs(a(n) - 8 / 4) < eps
end
