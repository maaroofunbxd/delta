# (a n + b) / (c n + d)
# |... - a/c| = |cb - ad| / |c(cn+d)|, bounded by |cb-ad|/(c^2 n)

sequence a(n) = (7 * n + (1)) / (3 * n + (5))
claim a(n) -> 7 / 3

proof:
    for every eps, where eps > 0
        there is N = ceil(32 / (9 * eps))
            for every n, where n > N
                abs(a(n) - 7 / 3) < eps
end
