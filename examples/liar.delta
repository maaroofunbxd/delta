# This proof is WRONG.  1/n does not get below eps for every n > N here.
#
# But it passes every check with the default sample of eps, and the tool
# reports "no counterexample".  See the README for the value of eps that
# breaks it.

sequence a(n) = 1 / n
claim a(n) -> 0

proof:
    for every eps, where eps > 0
        there is N = ceil((1 - 1/100000000) / eps)
            for every n, where n > N
                abs(a(n) - 0) < eps
end
